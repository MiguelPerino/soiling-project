# cp terraform.tfvars.example terraform.tfvars   (o .tfvars real está no .gitignore: tem senha)
subscription_id = "00000000-0000-0000-0000-000000000000"   # az account show --query id -o tsv
location        = "brazilsouth"                            # troque se a conta de estudante bloquear a região
admin_api_key   = "troque-por-uma-chave-longa"             # >= 12 caracteres; é a chave que você digita na tela
image_tag       = "v1"
persistent      = false     # true = PostgreSQL + Azure Files (dados sobrevivem)
min_replicas    = 1
# gemini_api_key = ""
# gemini_model   = ""
